# environments and secrets
.venv/
.env
__pycache__/
*.pyc
.DS_Store
.claude/

# full raw API log (contains an account id); publish a redacted copy instead
logs/raw_calls.jsonl

# unpacked human data; re-create with: unzip data/herrmann2008/HerrmannThoeniGaechter.zip -d data/herrmann2008/raw
data/herrmann2008/raw/

# every log stays out of git
logs/

# run outputs (one .jsonl per run, analyses); regenerate, do not commit
results/
# run directories (results, summary, raw log); real runs write them OUTSIDE the repo
runs/

# version stamp of a code copy outside git (pgg_game.py --write-code-version); never committed
CODE_VERSION.json

# Zenodo deposit builds (regenerate with scripts/build_zenodo_expC.py)
release/zenodo_expC/build/
release/zenodo_expC/*.zip

# full release builds (regenerate with scripts/build_release.py)
release/full/
